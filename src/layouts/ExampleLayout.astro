---
import Page from "./Page.astro";
import ExamplesSideNav from "@components/SideNavigation/ExamplesSideNav";
import "../components/CodeBlock/styles.css";

const { frontmatter } = Astro.props;
const title = frontmatter?.title || "Nextflow Example";
const description = frontmatter?.description || "";
const image = frontmatter?.image || "";
---

<Page title={title} description={description} image={image}>
  <div class="container container-lg">
    <div class="flex flex-col lg:flex-row lg:gap-12">
      <div class="mb-6 lg:mb-0 -mx-2 px-2 lg:mx-0 lg:w-50">
        <ExamplesSideNav client:load />
      </div>

      <div class="flex-1">
        <div class="code-examples">
          <slot />
        </div>
      </div>
    </div>
  </div>
</Page>

<style>
  .code-examples :global(.blg-summary) {
    overflow: visible !important;
    position: relative;
  }

  .code-examples :global(.expressive-code) {
    margin-top: 1.5rem;
  }

  .code-examples :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .code-examples :global(ol),
  .code-examples :global(ul) {
    margin-block: 0.75rem 1.25rem;
    padding-inline-start: 1.75rem;
  }

  .code-examples :global(ol) {
    list-style-type: decimal;
  }

  .code-examples :global(ul) {
    list-style-type: disc;
  }

  /* ui-elements.css blanks all list markers globally; restore them here */
  .code-examples :global(ol > li::marker) {
    content: counter(list-item) ". ";
    color: inherit;
    font-weight: 600;
  }

  .code-examples :global(ul > li::marker) {
    content: "• ";
    color: inherit;
  }

  .code-examples :global(li) {
    padding-inline-start: 0.25rem;
    margin-block-end: 0.5rem;
  }

  .code-examples :global(li > p) {
    margin: 0;
  }

  .code-examples :global(li > .expressive-code) {
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }
</style>
