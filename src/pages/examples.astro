---
import Page from "@layouts/Page.astro";
import ExamplesSideNav from "@components/SideNavigation/ExamplesSideNav";
---

<Page title="Nextflow Examples">
  <div class="container container-lg">
    <h1>Nextflow Examples</h1>

    <div class="flex flex-col lg:flex-row lg:gap-12">
      <div class="mb-6 lg:mb-0 -mx-2 px-2 lg:mx-0 lg:w-50">
        <ExamplesSideNav client:load />
      </div>

      <div class="flex-1">
        <div id="examples-content">
          <p class="text-lg mb-6">
            Select an example from the menu to learn more about Nextflow workflows. These examples demonstrate key
            concepts and features of the Nextflow framework.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="border rounded-lg p-6 hover:shadow-md transition-shadow">
              <h3 class="text-xl font-medium mb-2">Basic pipeline</h3>
              <p class="mb-4">Write a simple pipeline with two processes and publish its outputs.</p>
              <a href="basic-pipeline.html" class="text-nextflow-green hover:underline">View example →</a>
            </div>

            <div class="border rounded-lg p-6 hover:shadow-md transition-shadow">
              <h3 class="text-xl font-medium mb-2">Mixing scripting languages</h3>
              <p class="mb-4">Use R and Python scripts in the same pipeline.</p>
              <a href="mixing-scripting-languages.html" class="text-nextflow-green hover:underline">View example →</a>
            </div>

            <div class="border rounded-lg p-6 hover:shadow-md transition-shadow">
              <h3 class="text-xl font-medium mb-2">BLAST pipeline</h3>
              <p class="mb-4">Split a FASTA file into chunks and run a BLAST query for each chunk in parallel.</p>
              <a href="blast-pipeline.html" class="text-nextflow-green hover:underline">View example →</a>
            </div>

            <div class="border rounded-lg p-6 hover:shadow-md transition-shadow">
              <h3 class="text-xl font-medium mb-2">RNA-Seq pipeline</h3>
              <p class="mb-4">Run quality control and transcript quantification on paired-end reads with modules.</p>
              <a href="rna-seq-pipeline.html" class="text-nextflow-green hover:underline">View example →</a>
            </div>

            <div class="border rounded-lg p-6 hover:shadow-md transition-shadow">
              <h3 class="text-xl font-medium mb-2">Machine Learning pipeline</h3>
              <p class="mb-4">Train and evaluate a variety of machine learning models and select the best one.</p>
              <a href="machine-learning-pipeline.html" class="text-nextflow-green hover:underline">View example →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Page>
